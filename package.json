{
  "name": "calendar-cli",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --minify --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --outdir=dist",
    "export": "npm run build && cp dist/index.js skills/calendar/calendar.js && if [ -f .env ]; then cp .env skills/calendar/.env; fi",
    "build:run": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argeeee/calendar-cli.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/argeeee/calendar-cli/issues"
  },
  "homepage": "https://github.com/argeeee/calendar-cli#readme",
  "dependencies": {
    "@argetim/arg-parser": "^1.0.0",
    "google-auth-library": "^11.3.3",
    "googleapis": "^182.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
